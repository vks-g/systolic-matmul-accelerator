---
config:
  flowchart:
    nodeSpacing: 24
    rankSpacing: 22
    padding: 10
    wrappingWidth: 320
---
flowchart TB
  accTitle: Sequential baseline block diagram — one MAC, same host interface as the accelerator
  accDescr: seq_matmul keeps the same ports, address map and host protocol as systolic_top. Operand storage holds A and B. Row, column and k counters address the storage. A single multiplier and adder form one MAC; the running sum restarts at zero, or at the stored C element on an accumulate run. Each finished element is written to the C store in the cycle of its last product. The sequencer is busy for N squared times k_len cycles.

  subgraph top["seq_matmul"]
    direction TB
    host["Host ports (identical to systolic_top)<br/>a_we/a_addr/a_wdata, b_we/b_addr/b_wdata<br/>start, k_len, accumulate → busy, done, cycle_count<br/>c_addr → c_rdata"]
    seq["Sequencer: IDLE → COMPUTE → DONE<br/>busy = N²·k_len cycles<br/>no clear or capture cycle<br/>k_len, accumulate sampled with start"]
    subgraph dp["Datapath — one MAC"]
      direction LR
      store["Operand storage<br/>A: N × K_MAX, B: K_MAX × N"]
      ctr["Counters<br/>row, col (0…N−1)<br/>k (0…k_len−1)"]
      mul["×<br/>signed DATA_W × DATA_W"]
      add["+<br/>sign-extended to ACC_W"]
      sum["sum register<br/>s0 = 0, or C[row][col]<br/>when accumulate"]
      cstore["C store: N × N<br/>written per element<br/>in its last-product cycle"]
      store --> mul
      ctr --> store
      mul --> add
      add --> sum
      sum --> add
      sum -->|"k = k_len−1: write C[row][col]"| cstore
    end
    host --> seq
    seq -.-> dp
  end
  classDef control fill:#fff3d6,stroke:#8b6016,color:#13263d
  class seq control
